# ============ REQUIRED ============
DATABASE_URL=postgresql://crawlseo@localhost:5432/crawlseo
APP_SECRET=change-me-to-random-string
# Generate with: openssl rand -hex 32

# ============ DOCKER COMPOSE DB CREDENTIALS ============
# POSTGRES_PASSWORD has no default. Compose fails closed when it is unset.
# The app connects as seo_app (not the superuser). APP_DB_PASSWORD has no default.
POSTGRES_USER=crawlseo
POSTGRES_PASSWORD=
POSTGRES_DB=crawlseo
APP_DB_PASSWORD=

# ============ READ-ONLY MVP (EUR-407) ============
# External writes stay off until CISO GO (EUR-406).
WRITE_MODE=off
BING_ENABLED=false
AUTOCOMPLETE_ENABLED=false
DISABLE_REGISTRATION=true
# Comma-separated. Unset or empty refuses every sign-in.
ALLOWED_EMAILS=
# Unset or empty denies every domain. Set the properties this deployment may crawl.
CRAWL_ALLOWED_DOMAINS=bezkolejki.org,eurekalb.com
# Promo stays hidden unless this is exactly false.
CRAWLSEO_HIDE_CLOUD_PROMO=true
# Shared secret for the orchestrator adapter. Unset disables /api/internal/jobs.
# ORCHESTRATOR_TOKEN=
# Bearer token for GET /metrics. Unset answers 401.
# METRICS_TOKEN=

# ============ GOOGLE OAUTH (required for GSC data) ============
# Get these from: https://console.cloud.google.com/
# Required scopes: openid, email, profile, https://www.googleapis.com/auth/webmasters.readonly
GOOGLE_CLIENT_ID=your-client-id-here
GOOGLE_CLIENT_SECRET=your-client-secret-here

# Optional: PageSpeed Insights API key (higher quota for Core Web Vitals)
# GOOGLE_PAGESPEED_KEY=

# ============ NEXTAUTH / AUTH.JS ============
# Production (Vercel): set to https://your-app.vercel.app
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-hex-32
# Leave unset. Auth.js trusts X-Forwarded-Host only when this is exactly true,
# which is safe solely behind a proxy that overwrites Host and X-Forwarded-Host.
# The compose port is bound to 127.0.0.1, so a reachable client must not be
# able to choose the OAuth callback host.
# AUTH_TRUST_HOST=true
# AUTH_SECRET works as an alias (the Auth.js v5 name). If both are set,
# NEXTAUTH_SECRET wins. The same value encrypts stored API keys, so changing it
# makes them unreadable.
# AUTH_SECRET=

# ============ OPTIONAL: Scheduling ============
# Cron format: "minute hour day-of-month month day-of-week"
# CRAWL_SCHEDULE=0 0 * * 0                    # Weekly Sunday midnight
# GSC_SYNC_SCHEDULE=0 2 * * *                 # Daily 2am UTC
# VITALS_SCHEDULE=0 3 * * 0                   # Weekly Sunday 3am UTC

# ============ OPTIONAL: Crawler ============
# A crawl stops after this many minutes (default 30). Mostly reached on sites
# whose robots.txt sets a Crawl-delay: the crawler then makes one request at a
# time on that host and reports the hosts it had to stop early.
# CRAWL_MAX_MINUTES=30

# Registration and the crawlseo.cloud card are set in the read-only block above.
# DISABLE_REGISTRATION defaults to closed. Set it to false only to create the
# first allowlisted account, then set it back to true.

# ============ OPTIONAL: Email Notifications ============
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=alerts@crawlseo.cloud

# ============ OPTIONAL: Telegram Notifications ============
# Get from: https://t.me/BotFather
# TELEGRAM_BOT_TOKEN=your-bot-token-here

# ============ OPTIONAL: Slack Notifications ============
# Create at: https://api.slack.com/messaging/webhooks
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ============ OPTIONAL: Redis (for job queue, future) ============
# REDIS_URL=redis://localhost:6379

# ============ NODE ENVIRONMENT ============
# NODE_ENV=development
