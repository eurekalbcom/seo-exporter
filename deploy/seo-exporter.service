[Unit]
Description=Read-only Google Search Console and Bing Webmaster exporter
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
DynamicUser=yes
User=seo-exporter
Group=seo-exporter
StateDirectory=seo-exporter
StateDirectoryMode=0700
WorkingDirectory=/var/lib/seo-exporter
Environment=SEO_EXPORTER_PORT=9108
Environment=SEO_EXPORTER_INTERVAL_SECONDS=3600
EnvironmentFile=-/etc/seo-exporter/environment
Environment=SEO_EXPORTER_BIND=127.0.0.1
Environment=SEO_EXPORTER_STATE_DIR=/var/lib/seo-exporter
Environment=PYTHONPATH=/opt/seo-exporter
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
LoadCredentialEncrypted=gsc.json:/etc/credstore.encrypted/seo-exporter-gsc.json
LoadCredentialEncrypted=bing.json:/etc/credstore.encrypted/seo-exporter-bing.json
ExecStart=/usr/bin/python3 -m seo_exporter
Restart=on-failure
RestartSec=30
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6
DevicePolicy=closed

[Install]
WantedBy=multi-user.target
